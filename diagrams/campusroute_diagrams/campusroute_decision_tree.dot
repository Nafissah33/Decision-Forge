digraph CampusRouteDecision {
graph [rankdir=LR, bgcolor="white", pad="0.28", nodesep="0.23", ranksep="0.55", fontname="Arial", label="CampusRoute | Decision tree — illustrative input", labelloc=t, fontsize=20, fontcolor="#18324B"];
node [fontname="Arial", fontsize=10, shape=box, style="rounded,filled", fillcolor="#EFF4FA", color="#9DB4CC", fontcolor="#18324B", margin="0.15,0.12"];
edge [fontname="Arial", fontsize=9, color="#74869B", arrowsize=0.7];
start [shape=oval, label="Evaluate each transport option", fillcolor="#DBEAFE"];
rank [shape=box, label="Rank eligible options\nPriority: earliest", fillcolor="#DBEAFE"];
final [shape=oval, label="Recommend: Train", fillcolor="#D3F4DF", color="#4B8260"];
rank -> final [label="choose best"];
bus_start [shape=oval, label="Bus", fillcolor="#F1F5F9"];
start -> bus_start;
bus_S [shape=diamond, label="Service operating?", fillcolor="#E5F5EA", color="#5E9E73"];
bus_start -> bus_S;
bus_S -> bus_F [label="Yes", color="#4F9567"];
bus_F [shape=diamond, label="Fare within budget?", fillcolor="#E5F5EA", color="#5E9E73"];
bus_F -> bus_D [label="Yes", color="#4F9567"];
bus_D [shape=diamond, label="Arrives before deadline?", fillcolor="#E5F5EA", color="#5E9E73"];
bus_D -> bus_W [label="Yes", color="#4F9567"];
bus_W [shape=diamond, label="Walking acceptable?", fillcolor="#E5F5EA", color="#5E9E73"];
bus_W -> bus_eligible [label="Yes", color="#4F9567"];
bus_eligible [label="ELIGIBLE\n08:50 | $3.00", fillcolor="#D3F4DF", color="#5E9E73"];
bus_eligible -> rank [label="qualifies"];
train_start [shape=oval, label="Train", fillcolor="#F1F5F9"];
start -> train_start;
train_S [shape=diamond, label="Service operating?", fillcolor="#E5F5EA", color="#5E9E73"];
train_start -> train_S;
train_S -> train_F [label="Yes", color="#4F9567"];
train_F [shape=diamond, label="Fare within budget?", fillcolor="#E5F5EA", color="#5E9E73"];
train_F -> train_D [label="Yes", color="#4F9567"];
train_D [shape=diamond, label="Arrives before deadline?", fillcolor="#E5F5EA", color="#5E9E73"];
train_D -> train_W [label="Yes", color="#4F9567"];
train_W [shape=diamond, label="Walking acceptable?", fillcolor="#E5F5EA", color="#5E9E73"];
train_W -> train_eligible [label="Yes", color="#4F9567"];
train_eligible [label="ELIGIBLE\n08:30 | $6.00", fillcolor="#D3F4DF", color="#5E9E73"];
train_eligible -> rank [label="qualifies"];
backup_start [shape=oval, label="Uber (backup)", fillcolor="#F1F5F9"];
start -> backup_start;
backup_S [shape=diamond, label="Service operating?", fillcolor="#E5F5EA", color="#5E9E73"];
backup_start -> backup_S;
backup_S -> backup_F [label="Yes", color="#4F9567"];
backup_F [shape=diamond, label="Fare within budget?", fillcolor="#FCE8E6", color="#CB736B"];
backup_F -> backup_reject [label="No", color="#C96B62"];
backup_reject [label="NOT ELIGIBLE\nFails F", fillcolor="#FCE8E6", color="#CB736B"];
}
